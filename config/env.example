# jpdev settings. Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/jpdev/env and edit.
# The file is sourced by bash. An environment variable of the same name overrides it.
# Every line below shows the default; a line you leave commented keeps the default.
# `jpdev env` prints the effective values and where each came from.

# Where jpdev keeps its logs, scratch copies for `jpdev mutants`, and Go build caches.
#JPDEV_SCRATCH="${XDG_STATE_HOME:-$HOME/.local/state}/jpdev"

# The machine lock every Go step holds, so two sessions never run Go at once.
#JPDEV_LOCK="$JPDEV_SCRATCH/harness.lock"

# Node steps: the resident-memory cap of the step's process group (MB) and its default timeout (s).
#JPDEV_NODE_RSS_MB=6000
#JPDEV_NODE_TIMEOUT_S=1200

# Go steps: ulimit -v (KB) and the default timeout (s). The per-clone GOCACHE sits under JPDEV_SCRATCH.
#JPDEV_GO_ULIMIT_KB=12000000
#JPDEV_GO_TIMEOUT_S=3000

# Python steps: ulimit -v (KB).
#JPDEV_PY_ULIMIT_KB=4000000

# The nvm directory node versions are read from ($NVM_DIR when set, else $HOME/.nvm).
#JPDEV_NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

# A file of extended regular expressions, one per line (# comments and blank lines ignored),
# that `jpdev record post` refuses to post: put the personal names that must not appear in
# public text there. `jpdev record post` refuses to post without this file (or --no-name-check),
# and refuses a file holding a pattern grep -E cannot compile.
#JPDEV_NAME_PATTERNS="${XDG_CONFIG_HOME:-$HOME/.config}/jpdev/name-patterns"

# A manifest may name an environment variable a step needs (requires_env). The agent
# repository's parity step needs the Desk checkout it compares against; export it here.
#export JPDEV_DESK=/path/to/a/checkout/of/judgment-pack-desk
