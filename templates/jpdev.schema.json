{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jpdev generated document declarations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generators"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "generators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "run",
          "outputs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "run": {
            "type": "string",
            "minLength": 1
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
