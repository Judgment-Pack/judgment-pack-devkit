{
  "version": 1,
  "duplication": {
    "languages": ["go", "python", "typescript"],
    "paths": ["**"],
    "exclude": ["**/testdata/**", "**/*.gen.go"],
    "min_tokens": 70,
    "min_lines": 6
  },
  "generators": [
    {
      "name": "reference",
      "run": "python3 scripts/gen-reference.py",
      "outputs": [
        "docs/reference.md"
      ],
      "timeout": 120,
      "dependencies": []
    }
  ]
}
