{
  "version": 1,
  "generators": [
    {
      "name": "reference",
      "run": "python3 scripts/gen-reference.py",
      "outputs": [
        "docs/reference.md"
      ],
      "timeout": 120,
      "dependencies": []
    }
  ],
  "changed": [
    {
      "paths": ["docs/**", "*.md"],
      "checks": ["generated-docs", "diff-check"]
    },
    {
      "paths": ["go/**"],
      "checks": ["generated-docs", "go-test", "diff-check"]
    },
    {
      "paths": ["packages/example/**"],
      "checks": ["build", "unit-tests", "diff-check"]
    },
    {
      "paths": ["tests/**/*.py"],
      "checks": ["python-tests", "diff-check"]
    }
  ]
}
