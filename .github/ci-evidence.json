{
  "$comment": "The release evidence gate's configuration (docs/ci-evidence.md), read at the release commit by scripts/dev/release_evidence.py.",
  "schema": 2,
  "repository": "Judgment-Pack/judgment-pack-devkit",
  "branch": "main",
  "max_age_hours": 48,
  "inputs": [
    "dev.json",
    "jpdev.json",
    "scripts/dev/check.sh",
    "scripts/dev/changed_checks.py",
    "scripts/dev/generated_docs.py",
    "scripts/dev/release_evidence.py",
    "lib/release_evidence.py",
    "lib/generated_docs.py",
    "lib/duplication.py",
    "templates/check.sh",
    "templates/dev.json",
    "templates/jpdev.json",
    "templates/jpdev.schema.json",
    "tests/generated_docs_test.py",
    "tests/run.sh"
  ],
  "fresh_at_release": [
    "tag grammar, annotated tag, tag names the commit, commit on main",
    "release notes",
    "release environment reviewer",
    "kit version and vendored copies",
    "packaged kit run",
    "checksums",
    "attestation",
    "no existing release, draft identity",
    "published asset digests"
  ],
  "revalidation": {
    "$comment": "A hosted image rolled under the same label decides revalidate: release.yml runs the whole check list on a release runner (docs/ci-evidence.md#revalidation).",
    "allowed": true
  },
  "profiles": {
    "kit": {
      "platform": {
        "RUNNER_OS": "Linux",
        "RUNNER_ARCH": "X64"
      },
      "compare": "release-runner",
      "tools": {
        "bash": ["bash", "--version"],
        "git": ["git", "--version"],
        "python": ["python3", "--version"],
        "go": ["go", "version"],
        "shellcheck": ["shellcheck", "--version"],
        "rsync": ["rsync", "--version"]
      }
    }
  },
  "workflows": {
    "ci": {
      "path": ".github/workflows/ci.yml",
      "name": "CI",
      "events": ["push", "workflow_dispatch"],
      "jobs": {
        "lint": {
          "name": "lint",
          "job_id": "lint",
          "labels": ["ubuntu-latest"],
          "profile": "kit",
          "checks": ["diff-check", "local-paths", "agent-docs", "bash-n", "duplication", "json", "shellcheck"]
        },
        "tests": {
          "name": "tests",
          "job_id": "tests",
          "labels": ["ubuntu-latest"],
          "profile": "kit",
          "checks": ["tests"]
        }
      }
    }
  }
}
