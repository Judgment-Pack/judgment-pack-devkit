{
  "version": 1,
  "handover": {
    "boundary_paths": ["gate", "verdict"],
    "shared_paths": ["contract", "vectors", "docs/reference"]
  },
  "toolchains": {"go": {}, "python": {}},
  "setup": [
    {"name": "prepare", "run": "echo prepared", "toolchain": "shell"}
  ],
  "checks": [
    {"name": "first", "run": "echo 'Tests 3 passed'", "toolchain": "shell", "summary": "^Tests "},
    {"name": "go-version", "run": "go version", "toolchain": "go", "summary": "^go version"},
    {"name": "go-env", "run": "go env GOFLAGS GOCACHE", "toolchain": "go"},
    {"name": "python-version", "run": "python3 --version", "toolchain": "python", "summary": "^Python"},
    {"name": "many-lines", "run": "printf 'ok a\\nok b\\nok c\\nok d\\n'", "toolchain": "shell", "summary": "^ok "},
    {"name": "needs-variable", "run": "echo never", "toolchain": "shell", "requires_env": "JPDEV_FIXTURE_UNSET"},
    {"name": "optional-skip", "run": "echo never", "toolchain": "shell", "requires_env": "JPDEV_FIXTURE_UNSET", "optional": true},
    {"name": "fails", "run": "i=1; while [ $i -le 50 ]; do echo \"output line $i\"; i=$((i+1)); done; exit 3", "toolchain": "shell"},
    {"name": "after-failure", "run": "echo after", "toolchain": "shell"}
  ],
  "mutants": {"run": "bash tests/fixture/mutants.sh {rows}", "cwd": ".", "toolchain": "shell"}
}
