#!/usr/bin/env bash
# jpdev: the development kit of the Judgment Pack repositories. See README.md.
set -u
here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
kit=$(dirname "$here")
# shellcheck source=lib/common.sh
. "$kit/lib/common.sh"
jpdev_load_config

usage() {
  cat <<'USAGE'
usage: jpdev COMMAND [ARGS]
  setup DIR [--repo OWNER/NAME] [--branch NAME] [--base origin/main] [--manifest FILE]
                     clone (or reuse) a repository, make the branch, select the toolchains
                     the manifest names, and run its setup steps under the caps
  check [--only A,B | --changed [BASE]] [--skip A,B] [--all] [--manifest FILE]
                     run the manifest's checks in order under the caps; exit status = failures;
                     --changed runs only the steps jpdev.json maps the paths changed since the
                     merge base of BASE (default: the default branch) and HEAD to; the whole list
                     runs when a changed path is unmapped, when jpdev.json, the manifest or
                     scripts/dev/check.sh changed, when nothing changed, or with no mapping
  mutants --row TEXT [--row TEXT]...
                     run the manifest's mutants command on a scratch copy of the clone
  record post (--pr N | --issue N) --file FILE [--repo OWNER/NAME] [--dry-run] [--no-name-check]
                     reduce local paths, refuse a path, a name pattern, a missing or invalid
                     name-pattern file, then post the file
  push [BRANCH]      push BRANCH (default: the current branch) to origin with the gh credential
                     helper and no stored credential; refuses --force and -f
  clean [--root DIR]... [--older-than DURATION] [--min-transcript-bytes N] [--yes]
                     inspect explicit session disposal seals; dry run by default
                     transcripts default to at least 10485760 logical bytes; 0 disables the floor
  clean init --root DIR --session TOKEN
  clean seal --root DIR --session TOKEN --path REL --kind KIND
             [--base DIR] [--removed-worktree DIR]
                     enroll an empty session root, then seal session-created disposable state
  worktree add BASE BRANCH [DIR]
  worktree list BASE
  worktree remove DIR [--force]
                     add, list or remove managed git worktrees; removal refuses dirty or
                     unpushed work unless --force
  carry --pr N --model M --effort low|medium|high [--dir CLONE] [--repo OWNER/NAME]
        [--worktree BASE]
                     merge origin/main into a pull-request branch, sign and push a clean carry,
                     or start Codex on a generated carry brief when conflicts remain
  codex run --brief FILE --model M --effort low|medium|high [--dir CLONE] [--repo OWNER/NAME]
            [--base main] [--add PATH]... [--no-commit] [--no-push] [--no-pr]
            [--sandbox workspace-write|danger-full-access] [--log FILE]
            [--worktree BASE] [--branch NAME] [--small] [--resume THREAD]
                     check the brief, run `codex exec` on it in CLONE (a work branch) with the
                     model, effort and sandbox explicit, stdin closed and the transcript in the
                     log; print the final message and the exit code; then commit the tracked
                     changes (msg.txt, signed off), push, and open the pull request (pr.md)
  codex review --brief FILE --model M --effort low|medium|high --dir CLONE
        [--pr N | --issue N] [--repo OWNER/NAME] [--out FILE]
        [--sandbox read-only|workspace-write] [--network]
                     run a review with stdin closed, write its final message, refuse tracked
                     changes after the run, and print the reviewed SHA; no network unless
                     --network, and never commit, push or post
  codex brief-template [--review]
                     print the brief skeleton: what Codex writes (msg.txt, pr.md) and does not do
  codex check-brief [--build] FILE
                     refuse a brief that holds a word of the filter list, and suggest the
                     neutral phrasing; require the handover heading for a build brief
  env                print the effective settings and where each came from
  --version          print the version
  version            print the version and, when the kit is a git checkout, the commit it is at
                     (git describe), which tells a kit at a release from one past it
USAGE
}

# kit_version prints the version, with the kit checkout's git describe when the kit is its own clone.
kit_version() {
  local top described=""
  top=$(git -C "$kit" rev-parse --show-toplevel 2>/dev/null) || top=""
  if [ -n "$top" ] && [ "$top" -ef "$kit" ]; then
    described=$(git -C "$kit" describe --tags --always 2>/dev/null) || described=""
  fi
  printf 'jpdev %s%s\n' "$JPDEV_VERSION" "${described:+ ($described)}"
}

need_value() { [ $# -ge 2 ] || jpdev_die "$1 needs a value"; }

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || jpdev_die "not inside a git clone"
}

cmd_check() {
  local root manifest="" passthru=() changed=0 only=0 base_args=()
  while [ $# -gt 0 ]; do
    case $1 in
      --manifest) need_value "$@"; manifest=$2; shift 2 ;;
      --only) need_value "$@"; passthru+=("$1" "$2"); only=1; shift 2 ;;
      --skip) need_value "$@"; passthru+=("$1" "$2"); shift 2 ;;
      --all) passthru+=(--all); shift ;;
      --changed)
        changed=1; shift
        if [ $# -gt 0 ] && [[ $1 != -* ]]; then base_args=(--base "$1"); shift; fi
        ;;
      -h | --help) usage; exit 0 ;;
      *) jpdev_die "check: unknown argument $1; this kit is $(kit_version), and \`jpdev check --help\` lists what it takes" ;;
    esac
  done
  [ "$changed" -eq 0 ] || [ "$only" -eq 0 ] || jpdev_die "check: --changed and --only both choose the steps; give one"
  root=$(repo_root)
  : "${manifest:=$root/dev.json}"
  jpdev_prepare_run "$root" "$manifest"
  if [ "$changed" -eq 1 ]; then
    # The first line is the selection (whole, or only NAME,NAME); the rest is the report.
    local selection first
    selection=$(python3 -I "$kit/lib/changed_checks.py" --root "$root" --manifest "$manifest" "${base_args[@]}") ||
      jpdev_die "check --changed: refused by this kit, $(kit_version)"
    first=${selection%%$'\n'*}
    printf '%s\n' "${selection#*$'\n'}"
    case $first in
      whole) ;;
      "only "?*) passthru+=(--only "${first#only }") ;;
      *) jpdev_die "check --changed: the selection could not be read" ;;
    esac
  fi
  local script=$root/scripts/dev/check.sh
  [ -x "$script" ] || script=$kit/templates/check.sh
  local logdir
  logdir=$JPDEV_SCRATCH/logs/$(basename "$root")-$(date +%Y%m%dT%H%M%S)
  export JPDEV_LOGDIR=$logdir
  "$script" --manifest "$manifest" "${passthru[@]}"
  local status=$?
  if compgen -G "$logdir/*.log" > /dev/null; then
    jpdev_log "full output of each check: $logdir"
  fi
  exit "$status"
}

cmd_setup() {
  local dir="" repo="" branch="" base=origin/main manifest=""
  while [ $# -gt 0 ]; do
    case $1 in
      --repo) need_value "$@"; repo=$2; shift 2 ;;
      --branch) need_value "$@"; branch=$2; shift 2 ;;
      --base) need_value "$@"; base=$2; shift 2 ;;
      --manifest) need_value "$@"; manifest=$2; shift 2 ;;
      -h | --help) usage; exit 0 ;;
      -*) jpdev_die "setup: unknown argument $1" ;;
      *) [ -z "$dir" ] || jpdev_die "setup: one directory only"; dir=$1; shift ;;
    esac
  done
  [ -n "$dir" ] || jpdev_die "setup: a directory is needed"
  if [ ! -e "$dir/.git" ]; then
    [ -n "$repo" ] || jpdev_die "setup: $dir is not a clone; give --repo OWNER/NAME to clone it"
    gh repo clone "$repo" "$dir" -- -q || jpdev_die "setup: the clone failed"
  fi
  local root
  root=$(cd "$dir" && git rev-parse --show-toplevel) || jpdev_die "setup: $dir is not a git clone"
  cd "$root" || exit 2
  [ -n "$repo" ] || repo=$(git remote get-url origin 2>/dev/null | sed -E 's#^(git@github.com:|https://github.com/)##; s#\.git$##')
  jpdev_git_net fetch -q origin || jpdev_die "setup: git fetch failed"
  if [ -n "$branch" ]; then
    if git show-ref --verify -q "refs/heads/$branch"; then
      git switch -q "$branch" || jpdev_die "setup: cannot switch to $branch"
    else
      git switch -q -c "$branch" "$base" || jpdev_die "setup: cannot create $branch from $base"
    fi
  fi
  : "${manifest:=$root/dev.json}"
  jpdev_prepare_run "$root" "$manifest"
  local go_v py_v venv pyv py gov
  if [ -n "$(jpdev_manifest_get "$manifest" toolchains go)" ]; then
    go_v=$("${JPDEV_GO_BIN:+$JPDEV_GO_BIN/}go" version 2>/dev/null) || jpdev_die "setup: the manifest names go, which is not on PATH"
    gov=$(jpdev_manifest_get "$manifest" toolchains go version)
    if [ -n "$gov" ] && [ -n "${JPDEV_GO_BIN:-}" ]; then
      go_v="$go_v (selected for the manifest's go $gov)"
    elif [ -n "$gov" ]; then
      go_v="$go_v (the manifest names go $gov and no matching Go is installed: this one is used)"
    fi
  fi
  venv=$(jpdev_manifest_get "$manifest" toolchains python venv)
  pyv=$(jpdev_manifest_get "$manifest" toolchains python version)
  py=python3
  if [ -n "$pyv" ]; then
    py=$(jpdev_python_bin "$pyv") || jpdev_die "setup: the manifest names python $pyv, which is not installed (python$pyv on PATH, or a pyenv version)"
  fi
  if [ -n "$venv" ]; then
    if [ ! -d "$root/$venv" ]; then
      JPDEV_STEP_TIMEOUT=300 "$JPDEV_WRAP" python -- "$py" -m venv "$root/$venv" || jpdev_die "setup: the virtual environment failed"
    fi
    py_v=$("$root/$venv/bin/python" --version 2>&1)
    grep -qxF "/$venv/" "$root/.git/info/exclude" 2>/dev/null || printf '/%s/\n' "$venv" >> "$root/.git/info/exclude"
  else
    py_v=$("$py" --version 2>&1)
  fi
  local script=$root/scripts/dev/check.sh
  if [ ! -x "$script" ] || [ ! -x "$root/scripts/dev/handover_check.sh" ]; then
    jpdev_log "setup: adopting repositories vendor scripts/dev/check.sh and scripts/dev/handover_check.sh together"
  fi
  [ -x "$script" ] || script=$kit/templates/check.sh
  JPDEV_LOGDIR=$JPDEV_SCRATCH/logs/$(basename "$root")-setup-$(date +%Y%m%dT%H%M%S)
  export JPDEV_LOGDIR
  local block status
  block=$("$script" --manifest "$manifest" --setup --all)
  status=$?
  echo "== jpdev setup =="
  printf '%-8s %s\n' repo "${repo:-unknown}" dir "$dir" \
    branch "$(git rev-parse --abbrev-ref HEAD) at $(git rev-parse --short HEAD) (base $base)" \
    node "${JPDEV_NODE_BIN:+$("$JPDEV_NODE_BIN/node" --version)}" \
    go "${go_v:-not used}" python "$py_v${venv:+ (virtual environment $venv)}"
  printf '%s\n' "$block"
  exit "$status"
}

cmd_mutants() {
  local rows=() manifest=""
  while [ $# -gt 0 ]; do
    case $1 in
      --row) need_value "$@"; rows+=("$2"); shift 2 ;;
      --manifest) need_value "$@"; manifest=$2; shift 2 ;;
      -h | --help) usage; exit 0 ;;
      *) jpdev_die "mutants: unknown argument $1" ;;
    esac
  done
  [ ${#rows[@]} -gt 0 ] || jpdev_die "mutants: at least one --row TEXT is needed"
  local root run cwd tc tmo
  root=$(repo_root)
  : "${manifest:=$root/dev.json}"
  jpdev_prepare_run "$root" "$manifest"
  run=$(jpdev_manifest_get "$manifest" mutants run)
  [ -n "$run" ] || jpdev_die "mutants: the manifest has no mutants command"
  cwd=$(jpdev_manifest_get "$manifest" mutants cwd); : "${cwd:=.}"
  tc=$(jpdev_manifest_get "$manifest" mutants toolchain)
  if [ -z "$tc" ]; then if [ -n "${JPDEV_NODE_BIN:-}" ]; then tc=node; else tc=shell; fi; fi
  tmo=$(jpdev_manifest_get "$manifest" mutants timeout); : "${tmo:=3000}"
  copy=$JPDEV_SCRATCH/mutants/$(jpdev_clone_key "$root")-$$
  mkdir -p "$copy"
  trap 'rm -rf -- "${copy:?}"' EXIT
  # A builder's scratch and TMPDIR can be below the clone. Never copy generated state
  # or the destination back into itself; preserve their parents and ordinary source siblings.
  local exclude=(--exclude .git --exclude node_modules --exclude .venv) prune=(-path "$root/.git")
  local generated generated_real escaped rel
  for generated in "$copy" "$JPDEV_SCRATCH" "${TMPDIR:-}"; do
    [ -d "$generated" ] || continue
    generated_real=$(cd "$generated" && pwd -P) || jpdev_die "mutants: cannot resolve generated directory"
    if [ "$generated_real" != "$root" ] && [[ $generated_real = "$root/"* ]]; then
      rel=${generated_real#"$root"/}
      escaped=${rel//\\/\\\\}; escaped=${escaped//\*/\\*}; escaped=${escaped//\?/\\?}; escaped=${escaped//\[/\\[}
      exclude+=(--exclude "/$escaped/")
      escaped=${generated_real//\\/\\\\}; escaped=${escaped//\*/\\*}; escaped=${escaped//\?/\\?}; escaped=${escaped//\[/\\[}
      prune+=(-o -path "$escaped")
    fi
  done
  rsync -a "${exclude[@]}" "$root/" "$copy/" || jpdev_die "mutants: the scratch copy failed"
  local found
  while IFS= read -r found; do
    rel=${found#"$root"/}
    mkdir -p "$copy/$(dirname "$rel")"
    ln -s "$found" "$copy/$rel"
  done < <(find "$root" \( "${prune[@]}" \) -prune -o -name node_modules -type d -prune -print)
  local args="" row
  for row in "${rows[@]}"; do args+=$(printf ' --row %q' "$row"); done
  local out=$copy/.jpdev-mutants.out
  (cd "$copy/$cwd" && JPDEV_ROOT=$copy JPDEV_STEP_TIMEOUT=$tmo "$JPDEV_WRAP" "$tc" -- bash -c "${run//\{rows\}/$args}") > "$out" 2>&1
  local status=$?
  echo "== jpdev mutants (exit $status of the mutants command) =="
  python3 -I "$kit/lib/mutants_report.py" "${rows[@]}" < "$out"
  local missed=$?
  if [ "$missed" -eq 0 ] && [ "$status" -ne 0 ]; then
    echo "the command failed with no row reported; its last lines:"; tail -n 20 "$out"
    missed=1
  fi
  exit "$missed"
}

# reduce_paths FILE prints FILE with the scratch and home directories named as <scratch> and <home>.
reduce_paths() {
  python3 -I -c '
import os, sys
text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
pairs = [(sys.argv[2], "<scratch>"), (os.path.realpath(sys.argv[2]), "<scratch>"), (sys.argv[3], "<home>"), (os.path.realpath(sys.argv[3]), "<home>")]
for old, new in sorted(set(pairs), key=lambda p: -len(p[0])):
    if old.strip("/"):
        text = text.replace(old, new)
sys.stdout.write(text)' "$1" "$JPDEV_SCRATCH" "$HOME"
}

cmd_record() {
  [ "${1:-}" = post ] || jpdev_die "record: the only subcommand is post"
  shift
  local pr="" issue="" file="" repo="" dry=0 name_check=1
  while [ $# -gt 0 ]; do
    case $1 in
      --pr) need_value "$@"; pr=$2; shift 2 ;;
      --issue) need_value "$@"; issue=$2; shift 2 ;;
      --file) need_value "$@"; file=$2; shift 2 ;;
      --repo) need_value "$@"; repo=$2; shift 2 ;;
      --dry-run) dry=1; shift ;;
      --no-name-check) name_check=0; shift ;;
      *) jpdev_die "record: unknown argument $1" ;;
    esac
  done
  [ -f "$file" ] || jpdev_die "record: --file must name a file"
  { [ -n "$pr" ] && [ -z "$issue" ]; } || { [ -z "$pr" ] && [ -n "$issue" ]; } || jpdev_die "record: give --pr N or --issue N"
  local status=0
  tmpd=$(mktemp -d)
  trap 'rm -rf -- "${tmpd:?}"' EXIT
  local reduced=$tmpd/reduced
  reduce_paths "$file" > "$reduced"
  if grep -nE '(^|[^A-Za-z0-9_<.-])(/(home|tmp|Users|root|mnt)/[A-Za-z0-9_.-]+|~/[A-Za-z0-9_.-]+)' "$reduced" > "$tmpd/paths"; then
    echo "jpdev record: refused: a local path remains after the scratch and home paths were reduced:" >&2
    cut -d: -f1 "$tmpd/paths" | sed 's/^/  line /' >&2
    status=1
  fi
  if [ "$name_check" -eq 0 ]; then
    jpdev_log "--no-name-check: the name check did not run"
  elif [ ! -f "$JPDEV_NAME_PATTERNS" ]; then
    echo "jpdev record: refused: no name-pattern file at $JPDEV_NAME_PATTERNS (create it, or pass --no-name-check to post without the name check)" >&2
    status=1
  else
    local patterns=$tmpd/patterns grep_status
    grep -vE '^[[:space:]]*(#|$)' "$JPDEV_NAME_PATTERNS" > "$patterns"
    if [ ! -s "$patterns" ]; then
      jpdev_log "the name-pattern file $JPDEV_NAME_PATTERNS holds no pattern: the name check matched nothing"
    else
      grep -Eif "$patterns" /dev/null > /dev/null 2>&1
      grep_status=$?
      if [ "$grep_status" -eq 2 ]; then
        echo "jpdev record: refused: the name-pattern file holds a pattern grep -E cannot compile" >&2
        status=1
      else
        grep -nEif "$patterns" "$reduced" > "$tmpd/names"
        grep_status=$?
        if [ "$grep_status" -eq 0 ]; then
          echo "jpdev record: refused: these lines match a pattern of the name list:" >&2
          cut -d: -f1 "$tmpd/names" | sed 's/^/  line /' >&2
          status=1
        elif [ "$grep_status" -ne 1 ]; then
          echo "jpdev record: refused: the name check failed (grep exit $grep_status)" >&2
          status=1
        fi
      fi
    fi
  fi
  [ "$status" -eq 0 ] || exit 1
  local kind=pr number=$pr
  if [ -n "$issue" ]; then kind=issue; number=$issue; fi
  if [ "$dry" -eq 1 ]; then
    echo "jpdev record: dry run: would post $(wc -l < "$reduced") lines on $kind #$number${repo:+ of $repo}"
    exit 0
  fi
  gh "$kind" comment "$number" ${repo:+--repo "$repo"} --body-file "$reduced"
}

# cmd_push [BRANCH]: the push form with the gh credential helper, never a stored credential.
cmd_push() {
  local branch="" arg
  for arg in "$@"; do
    case $arg in
      --force* | -f* | +*) jpdev_die "push: refused: a force push is never made (jpdev push takes a branch name only)" ;;
      -*) jpdev_die "push: unknown argument $arg (jpdev push takes a branch name only)" ;;
      *) [ -z "$branch" ] || jpdev_die "push: one branch only"; branch=$arg ;;
    esac
  done
  repo_root > /dev/null
  if [ -z "$branch" ]; then
    branch=$(git symbolic-ref --short -q HEAD) || jpdev_die "push: HEAD is not on a branch; name the branch"
  fi
  git check-ref-format --branch "$branch" > /dev/null 2>&1 || jpdev_die "push: '$branch' is not a branch name"
  jpdev_git_net push -u origin "$branch"
}

# worktree_add BASE BRANCH DIR: add BRANCH from origin/main when it does not exist locally.
worktree_link_node_modules() {
  local base=$1 dir=$2
  [ -d "$base/node_modules" ] && [ ! -e "$dir/node_modules" ] || return 0
  if [ -f "$base/package-lock.json" ] && [ -f "$dir/package-lock.json" ] && cmp -s "$base/package-lock.json" "$dir/package-lock.json"; then
    ln -s "$base/node_modules" "$dir/node_modules" || jpdev_log "worktree: node_modules could not be linked; run npm ci in $dir"
  else
    jpdev_log "worktree: package-lock.json differs or is absent; run npm ci in $dir instead of linking node_modules"
  fi
}

worktree_add() {
  local base=$1 branch=$2 dir=$3 start=${4:-origin/main}
  [ -d "$base" ] || jpdev_die "worktree add: $base is not a clone"
  base=$(cd "$base" && git rev-parse --show-toplevel) || jpdev_die "worktree add: $base is not a git clone"
  git check-ref-format --branch "$branch" > /dev/null 2>&1 || jpdev_die "worktree add: '$branch' is not a branch name"
  [ ! -e "$dir" ] || jpdev_die "worktree add: $dir already exists"
  mkdir -p "$(dirname "$dir")"
  if git -C "$base" show-ref --verify -q "refs/heads/$branch"; then
    git -C "$base" worktree add "$dir" "$branch" || jpdev_die "worktree add: could not add $branch"
  else
    git -C "$base" worktree add -b "$branch" "$dir" "$start" || jpdev_die "worktree add: could not make $branch from $start"
  fi
  worktree_link_node_modules "$base" "$dir"
  printf '%s\n' "$(cd "$dir" && pwd)"
}

cmd_worktree() {
  local sub=${1:-}
  [ $# -eq 0 ] || shift
  case $sub in
    add)
      local base="" branch="" dir="" start=origin/main arg
      while [ $# -gt 0 ]; do
        case $1 in
          --branch) need_value "$@"; branch=$2; shift 2 ;;
          --dir) need_value "$@"; dir=$2; shift 2 ;;
          --base) need_value "$@"; start=$2; shift 2 ;;
          -*) jpdev_die "worktree add: unknown argument $1" ;;
          *)
            arg=$1; shift
            if [ -z "$base" ]; then base=$arg
            elif [ -z "$branch" ]; then branch=$arg
            elif [ -z "$dir" ]; then dir=$arg
            else jpdev_die "worktree add: too many arguments"
            fi
            ;;
        esac
      done
      if [ -z "$base" ] || [ -z "$branch" ]; then jpdev_die "worktree add: BASE and BRANCH are needed"; fi
      if [ -z "$dir" ]; then dir=$(dirname "$base")/"$(basename "$base")-${branch//\//-}"; fi
      worktree_add "$base" "$branch" "$dir" "$start" > /dev/null
      echo "== jpdev worktree add =="
      printf '%-8s %s\n' base "$(cd "$base" && pwd)" branch "$branch" worktree "$(cd "$dir" && pwd)"
      ;;
    list)
      [ $# -le 1 ] || jpdev_die "worktree list: give at most one base clone"
      local list_base=${1:-.}
      git -C "$list_base" worktree list || jpdev_die "worktree list: $list_base is not a git clone"
      ;;
    remove)
      local dir="" force=0
      while [ $# -gt 0 ]; do
        case $1 in
          --force) force=1 ;;
          -*) jpdev_die "worktree remove: unknown argument $1" ;;
          *) [ -z "$dir" ] || jpdev_die "worktree remove: one worktree directory only"; dir=$1 ;;
        esac
        shift
      done
      if [ -z "$dir" ] || [ ! -d "$dir" ]; then jpdev_die "worktree remove: give a worktree directory"; fi
      if [ "$force" -eq 0 ]; then
        local dirty
        dirty=$(git -C "$dir" status --porcelain | grep -vE '^\?\? (\.jpdev|\.gocache|\.npm-cache|\.xdg-cache|node_modules)(/|$)')
        [ -z "$dirty" ] || jpdev_die "worktree remove: refused: $dir has uncommitted work (pass --force to remove it)"
        local upstream
        upstream=$(git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || \
          jpdev_die "worktree remove: refused: $dir has no upstream, so its work is not known to be pushed (pass --force to remove it)"
        [ "$(git -C "$dir" rev-list --count "$upstream"..HEAD)" -eq 0 ] || \
          jpdev_die "worktree remove: refused: $dir has unpushed work (pass --force to remove it)"
      fi
      local remove_args=(worktree remove)
      [ "$force" -eq 0 ] || remove_args+=(--force)
      remove_args+=("$dir")
      git -C "$dir" "${remove_args[@]}" || jpdev_die "worktree remove: could not remove $dir"
      ;;
    -h | --help | help) usage ;;
    *) jpdev_die "worktree: the subcommands are add, list and remove" ;;
  esac
}

# cmd_codex run|check-brief ...
cmd_codex() {
  local sub=${1:-}
  [ $# -eq 0 ] || shift
  case $sub in
    run) codex_run "$@" ;;
    review) codex_review "$@" ;;
    check-brief) codex_check_brief "$@" ;;
    brief-template) codex_brief_template "$@" ;;
    -h | --help | help) usage; exit 0 ;;
    *) jpdev_die "codex: the subcommands are run, review, check-brief and brief-template" ;;
  esac
}

# codex_review: run Codex from a review brief and retain only its final report. The prompt and the
# post-run git gate make the role read-only; workspace-write remains the default because shell
# probes need temporary files.
codex_review() {
  local brief="" model=$JPDEV_CODEX_MODEL_DEFAULT effort="" dir="" sandbox=workspace-write
  local out="" repo="" pr="" issue="" log="" network=0 network_state=disabled
  while [ $# -gt 0 ]; do
    case $1 in
      --brief) need_value "$@"; brief=$2; shift 2 ;;
      --model) need_value "$@"; model=$2; shift 2 ;;
      --effort) need_value "$@"; effort=$2; shift 2 ;;
      --dir) need_value "$@"; dir=$2; shift 2 ;;
      --sandbox) need_value "$@"; sandbox=$2; shift 2 ;;
      --out) need_value "$@"; out=$2; shift 2 ;;
      --repo) need_value "$@"; repo=$2; shift 2 ;;
      --pr) need_value "$@"; pr=$2; shift 2 ;;
      --issue) need_value "$@"; issue=$2; shift 2 ;;
      --network) network=1; network_state=enabled; shift ;;
      -h | --help) usage; exit 0 ;;
      *) jpdev_die "codex review: unknown argument $1" ;;
    esac
  done
  [ -f "$brief" ] || jpdev_die "codex review: --brief must name a file"
  [ -n "$model" ] || jpdev_die "codex review: --model is needed (the model is always passed; JPDEV_CODEX_MODEL_DEFAULT can name one)"
  case $effort in low | medium | high) ;; *) jpdev_die "codex review: --effort is low, medium or high" ;; esac
  case $sandbox in read-only | workspace-write) ;; *) jpdev_die "codex review: --sandbox is read-only or workspace-write" ;; esac
  [ -n "$dir" ] || jpdev_die "codex review: --dir is needed"
  [ -d "$dir" ] || jpdev_die "codex review: --dir is not a directory"
  { [ -z "$pr" ] || [ -z "$issue" ]; } || jpdev_die "codex review: give --pr N or --issue N, not both"
  dir=$(cd "$dir" && git rev-parse --show-toplevel) || jpdev_die "codex review: --dir is not a git clone"
  [ -f "$dir/AGENTS.md" ] || jpdev_die "codex review: $dir holds no AGENTS.md, which the prompt names as the rules"
  command -v codex > /dev/null || jpdev_die "codex review: codex is not on PATH"
  brief=$(cd "$(dirname "$brief")" && pwd)/$(basename "$brief")
  local sha
  sha=$(git -C "$dir" rev-parse HEAD) || jpdev_die "codex review: cannot read HEAD"
  if [ -z "$out" ]; then out=$dir/.jpdev/output/review.md; fi
  mkdir -p "$(dirname "$out")" "$JPDEV_SCRATCH/logs"
  out=$(cd "$(dirname "$out")" && pwd)/$(basename "$out")
  log=$JPDEV_SCRATCH/logs/codex-review-$(basename "$dir")-$(date +%Y%m%dT%H%M%S).log
  jpdev_log "codex review: model $model, effort $effort, sandbox $sandbox, in $dir; transcript $log; network $network_state"
  codex_check_brief "$brief"
  local prompt="The rules are this repository's AGENTS.md; follow them. Act as its reviewer. Do not change tracked files or write git metadata."
  [ "$network" -eq 1 ] || prompt+=$'\n'"Do not access the network."
  if [ -n "$pr" ]; then prompt+=$'\n'"Review pull request #$pr${repo:+ of $repo} at head $sha."; fi
  if [ -n "$issue" ]; then prompt+=$'\n'"Review issue #$issue${repo:+ of $repo} at head $sha."; fi
  prompt+=$'\n'"$(cat "$brief")"
  local args=(exec -m "$model" -c "model_reasoning_effort=$effort" --sandbox "$sandbox")
  if [ "$network" -eq 1 ]; then args+=(-c sandbox_workspace_write.network_access=true); fi
  args+=(--json -C "$dir" -o "$out" "$prompt")
  (cd "$dir" && codex "${args[@]}" < /dev/null > "$log" 2>&1)
  local status=$?
  [ "$status" -eq 0 ] || { echo "== codex review exit $status (transcript: $log) =="; return "$status"; }
  [ -s "$out" ] || { echo "jpdev codex review: refused: codex wrote no final message" >&2; return 1; }
  if [ "$(git -C "$dir" rev-parse HEAD)" != "$sha" ] || ! git -C "$dir" diff --quiet || ! git -C "$dir" diff --cached --quiet; then
    echo "jpdev codex review: refused: the review changed tracked files or HEAD; restore the clone before continuing" >&2
    return 1
  fi
  local verdict
  verdict=$(grep -E '^(mergeable|not mergeable) — head ' "$out" | tail -n 1)
  [ -z "$verdict" ] || printf '%s\n' "$verdict"
  echo "jpdev codex review: reviewed $sha; record $out; transcript $log"
}

# codex_check_brief [--build] FILE: check the build heading and the filter-list words in FILE.
codex_check_brief() {
  local file="" build=0 root manifest
  while [ $# -gt 0 ]; do
    case $1 in
      --build) build=1; shift ;;
      -h | --help) usage; exit 0 ;;
      -*) jpdev_die "codex check-brief: unknown argument $1" ;;
      *) [ -z "$file" ] || jpdev_die "codex check-brief: one brief only"; file=$1; shift ;;
    esac
  done
  [ -f "$file" ] || jpdev_die "codex check-brief: give the brief file"
  if ! grep -qxF '## Before you write msg.txt' "$file"; then
    if [ "$build" -eq 1 ]; then
      echo "jpdev codex check-brief: refused: $file has no line exactly '## Before you write msg.txt'" >&2
      exit 1
    fi
    echo "jpdev codex check-brief: warning: $file has no line exactly '## Before you write msg.txt'" >&2
  fi
  if [ "$build" -eq 1 ]; then
    root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    manifest=${root:+$root/dev.json}
    if [ -n "$manifest" ] && [ -f "$manifest" ] && python3 -I - "$manifest" <<'PY'
import json, sys
try:
    notes = json.load(open(sys.argv[1], encoding='utf-8')).get('notes', [])
except (OSError, ValueError, AttributeError):
    notes = []
if not isinstance(notes, list): notes = []
sys.exit(0 if notes else 1)
PY
    then
      if ! grep -qxF "## This repository's notes" "$file"; then
        echo "jpdev codex check-brief: refused: $file has no line exactly '## This repository's notes', required by $manifest" >&2
        exit 1
      fi
    fi
  fi
  local out status
  out=$(python3 -I "$kit/lib/codex_words.py" "$file" "$kit/config/codex-words.txt" "$JPDEV_CODEX_WORDS")
  status=$?
  case $status in
    0) echo "jpdev codex check-brief: no word of the filter list in $file" ;;
    1)
      printf 'jpdev codex check-brief: refused: %s holds words the content filter trips on:\n' "$file" >&2
      printf '  %s\n' "${out//$'\n'/$'\n'  }" >&2
      echo "describe the documented refusal instead (the input, and the exact refusal the code must produce)" >&2
      exit 1
      ;;
    *) jpdev_die "codex check-brief: the check failed (exit $status)" ;;
  esac
}

# codex_run: the Codex CLI build from a brief, then the git part (commit, push, pull request).
# Codex runs in workspace-write and cannot write .git, so the wrapper commits, pushes and opens
# the pull request itself from the msg.txt and pr.md that Codex wrote.
codex_run() {
  local brief="" model=$JPDEV_CODEX_MODEL_DEFAULT effort="" dir=. sandbox=$JPDEV_CODEX_SANDBOX log=""
  local repo="" base=main commit=1 push=1 pr=1 adds=() worktree="" branch_arg="" small=0 resume=""
  while [ $# -gt 0 ]; do
    case $1 in
      --brief) need_value "$@"; brief=$2; shift 2 ;;
      --model) need_value "$@"; model=$2; shift 2 ;;
      --effort) need_value "$@"; effort=$2; shift 2 ;;
      --dir) need_value "$@"; dir=$2; shift 2 ;;
      --sandbox) need_value "$@"; sandbox=$2; shift 2 ;;
      --log) need_value "$@"; log=$2; shift 2 ;;
      --repo) need_value "$@"; repo=$2; shift 2 ;;
      --base) need_value "$@"; base=$2; shift 2 ;;
      --add) need_value "$@"; adds+=("$2"); shift 2 ;;
      --worktree) need_value "$@"; worktree=$2; shift 2 ;;
      --branch) need_value "$@"; branch_arg=$2; shift 2 ;;
      --small) small=1; shift ;;
      --resume) need_value "$@"; resume=$2; shift 2 ;;
      --no-commit) commit=0; shift ;;
      --no-push) push=0; shift ;;
      --no-pr) pr=0; shift ;;
      -h | --help) usage; exit 0 ;;
      *) jpdev_die "codex run: unknown argument $1" ;;
    esac
  done
  [ -f "$brief" ] || jpdev_die "codex run: --brief must name a file"
  [ -n "$model" ] || jpdev_die "codex run: --model is needed (the model is always passed; JPDEV_CODEX_MODEL_DEFAULT can name one)"
  case $effort in
    low | medium | high) ;;
    *) jpdev_die "codex run: --effort is low, medium or high" ;;
  esac
  case $sandbox in
    workspace-write | danger-full-access) ;;
    *) jpdev_die "codex run: --sandbox is workspace-write or danger-full-access" ;;
  esac
  if [ -n "$worktree" ] && [ ! -d "$dir" ]; then
    [ -n "$branch_arg" ] || branch_arg=$(basename "$dir")
    worktree_add "$worktree" "$branch_arg" "$dir" origin/main > /dev/null
  fi
  [ -d "$dir" ] || jpdev_die "codex run: --dir is not a directory"
  dir=$(cd "$dir" && pwd)
  if [ -n "$worktree" ]; then
    worktree=$(cd "$worktree" && git rev-parse --show-toplevel) || jpdev_die "codex run: --worktree is not a git clone"
    local common_dir want_common
    common_dir=$(git -C "$dir" rev-parse --git-common-dir 2>/dev/null) || jpdev_die "codex run: $dir is not a worktree"
    common_dir=$(cd "$dir" && cd "$common_dir" && pwd)
    want_common=$(cd "$worktree/.git" && pwd)
    [ "$common_dir" = "$want_common" ] || jpdev_die "codex run: $dir is not a worktree of $worktree"
    worktree_link_node_modules "$worktree" "$dir"
  fi
  [ -f "$dir/AGENTS.md" ] || jpdev_die "codex run: $dir holds no AGENTS.md, which the prompt names as the rules"
  command -v codex > /dev/null || jpdev_die "codex run: codex is not on PATH"
  local branch=""
  if [ "$commit" -eq 1 ]; then
    git -C "$dir" rev-parse --show-toplevel > /dev/null 2>&1 || jpdev_die "codex run: $dir is not a git clone (--no-commit runs codex alone)"
    branch=$(git -C "$dir" symbolic-ref --short -q HEAD) || jpdev_die "codex run: HEAD is not on a branch"
    case $branch in
      main | master) jpdev_die "codex run: the clone is on $branch; make a work branch first (the wrapper commits and pushes the current branch)" ;;
    esac
    if [ "$push" -eq 1 ] && [ "$pr" -eq 1 ] && [ -z "$repo" ]; then
      jpdev_die "codex run: --repo OWNER/NAME is needed to open the pull request (--no-pr stops after the push)"
    fi
    local path
    for path in "${adds[@]}"; do
      case $path in
        msg.txt | pr.md | ./msg.txt | ./pr.md) jpdev_die "codex run: --add $path: msg.txt and pr.md are read, never committed" ;;
        .jpdev | .jpdev/* | ./.jpdev | ./.jpdev/* | \
        .gocache | .gocache/* | ./.gocache | ./.gocache/* | \
        .npm-cache | .npm-cache/* | ./.npm-cache | ./.npm-cache/* | \
        .xdg-cache | .xdg-cache/* | ./.xdg-cache | ./.xdg-cache/*)
          jpdev_die "codex run: --add $path: a sandbox cache directory is never committed" ;;
        .jpdev-shared | .jpdev-shared/* | ./.jpdev-shared | ./.jpdev-shared/*)
          jpdev_die "codex run: --add $path: a shared cache directory is never committed" ;;
        /* | .. | ../* | */../*) jpdev_die "codex run: --add takes a path inside the clone" ;;
      esac
    done
  fi
  brief=$(cd "$(dirname "$brief")" && pwd)/$(basename "$brief")
  (cd "$dir" && codex_check_brief --build "$brief") || exit $?
  if [ -z "$log" ]; then
    mkdir -p "$JPDEV_SCRATCH/logs"
    log=$JPDEV_SCRATCH/logs/codex-$(basename "$dir")-$(date +%Y%m%dT%H%M%S).log
  fi
  mkdir -p "$(dirname "$log")"
  log=$(cd "$(dirname "$log")" && pwd)/$(basename "$log")
  local final prompt
  final=$(mktemp)
  # a msg.txt or pr.md left by an earlier run is not this run's
  rm -f -- "$dir/msg.txt" "$dir/pr.md"
  prompt="The rules are this repository's AGENTS.md; follow them."
  if [ "$small" -eq 1 ]; then
    prompt+=$'\nThis is a small fix: run `jpdev check --changed`, which runs only the check-list steps jpdev.json maps the changed paths to (the whole list when a path is unmapped); do not choose the steps yourself. CI checks the pull request the same way and runs the whole list on the default branch.'
  fi
  prompt+=$'\n'"$(cat "$brief")"
  local args=(exec -m "$model" -c "model_reasoning_effort=$effort" --sandbox "$sandbox")
  if [ "$sandbox" = workspace-write ]; then args+=(-c sandbox_workspace_write.network_access=true); fi
  args+=(--json -C "$dir" -o "$final")
  if [ -n "$resume" ]; then args+=(resume "$resume"); fi
  args+=("$prompt")
  local codex_scratch=$JPDEV_SCRATCH codex_lock=$JPDEV_LOCK codex_gocache=${GOCACHE:-}
  local codex_goflags=${GOFLAGS:-} codex_npm_cache=${npm_config_cache:-} codex_xdg_cache=${XDG_CACHE_HOME:-}
  local set_vars=()
  if [ "${JPDEV_SOURCE[JPDEV_SCRATCH]}" = default ]; then codex_scratch=$dir/.jpdev; set_vars+=(JPDEV_SCRATCH); fi
  if [ "${JPDEV_SOURCE[JPDEV_LOCK]}" = default ]; then codex_lock=$dir/.jpdev/lock; set_vars+=(JPDEV_LOCK); fi
  if [ -z "$codex_gocache" ]; then codex_gocache=${worktree:+$worktree/.jpdev-shared/gocache}; codex_gocache=${codex_gocache:-$dir/.gocache}; set_vars+=(GOCACHE); fi
  if [ -z "$codex_goflags" ]; then codex_goflags=-mod=readonly; set_vars+=(GOFLAGS); fi
  if [ -z "$codex_npm_cache" ]; then codex_npm_cache=${worktree:+$worktree/.jpdev-shared/npm-cache}; codex_npm_cache=${codex_npm_cache:-$dir/.npm-cache}; set_vars+=(npm_config_cache); fi
  if [ -z "$codex_xdg_cache" ]; then codex_xdg_cache=${worktree:+$worktree/.jpdev-shared/xdg-cache}; codex_xdg_cache=${codex_xdg_cache:-$dir/.xdg-cache}; set_vars+=(XDG_CACHE_HOME); fi
  if [ -n "$worktree" ]; then
    mkdir -p "$dir/.jpdev" "$worktree/.jpdev-shared/gocache" "$worktree/.jpdev-shared/npm-cache" "$worktree/.jpdev-shared/xdg-cache"
  else
    mkdir -p "$dir/.jpdev" "$dir/.gocache" "$dir/.npm-cache" "$dir/.xdg-cache"
  fi
  jpdev_log "codex run: sandbox environment set: ${set_vars[*]:-none}"
  jpdev_log "codex run: model $model, effort $effort, sandbox $sandbox, in $dir; transcript $log"
  (
    cd "$dir" || exit 2
    [ "${JPDEV_SOURCE[JPDEV_SCRATCH]}" != default ] || export JPDEV_SCRATCH=$codex_scratch
    [ "${JPDEV_SOURCE[JPDEV_LOCK]}" != default ] || export JPDEV_LOCK=$codex_lock
    [ -n "${GOCACHE:-}" ] || export GOCACHE=$codex_gocache
    [ -n "${GOFLAGS:-}" ] || export GOFLAGS=$codex_goflags
    [ -n "${npm_config_cache:-}" ] || export npm_config_cache=$codex_npm_cache
    [ -n "${XDG_CACHE_HOME:-}" ] || export XDG_CACHE_HOME=$codex_xdg_cache
    export TMPDIR=$codex_scratch/tmp
    mkdir -p "$TMPDIR" || exit 2
    codex "${args[@]}" < /dev/null > "$log" 2>&1
  )
  local status=$?
  mkdir -p "$dir/.jpdev/output"
  local thread
  thread=$(python3 -I - "$log" <<'PY'
import json, re, sys
found = ""
for line in open(sys.argv[1], encoding="utf-8", errors="replace"):
    try:
        value = json.loads(line)
    except Exception:
        value = None
    todo = [value]
    while todo:
        item = todo.pop()
        if isinstance(item, dict):
            for key, val in item.items():
                if key in ("thread_id", "threadId") and isinstance(val, str): found = val
                elif isinstance(val, (dict, list)): todo.append(val)
        elif isinstance(item, list): todo.extend(item)
    match = re.search(r'(?:thread[_ ]id[=: ]+)([A-Za-z0-9_-]+)', line, re.I)
    if match: found = match.group(1)
print(found)
PY
)
  if [ -z "$thread" ]; then thread=$resume; fi
  if [ -n "$thread" ]; then printf '%s\n' "$thread" > "$dir/.jpdev/output/thread"; fi
  echo "== codex final message =="
  if [ -s "$final" ]; then cat "$final"; else echo "(none written)"; fi
  rm -f -- "$final"
  echo "== codex exit $status (transcript: $log) =="
  if [ "$status" -ne 0 ]; then exit "$status"; fi
  if [ "$small" -eq 1 ]; then codex_small_check "$dir"; fi
  if [ "$commit" -eq 0 ]; then exit 0; fi
  codex_publish "$dir" "$branch" "$push" "$pr" "$repo" "$base" "${adds[@]}"
}

# codex_small_check DIR refuses a small run after Codex has changed a handover path or too many lines.
codex_small_check() {
  local dir=$1 manifest
  manifest=$dir/dev.json
  [ -f "$manifest" ] || jpdev_die "codex run --small: $dir has no dev.json"
  local result status
  result=$(python3 -I - "$dir" "$manifest" "$JPDEV_SMALL_MAX_LINES" <<'PY'
import json, os, subprocess, sys
root, manifest, limit_text = sys.argv[1:]
try:
    limit = int(limit_text)
    if limit < 0: raise ValueError
except ValueError:
    print("JPDEV_SMALL_MAX_LINES must be a non-negative integer")
    raise SystemExit(2)
m = json.load(open(manifest, encoding="utf-8"))
handover = m.get("handover", {})
protected = handover.get("shared_paths", []) + handover.get("boundary_paths", [])
names = subprocess.check_output(["git", "-C", root, "status", "--porcelain", "-z"]).split(b"\0")
paths = []
for row in names:
    if not row: continue
    path = row[3:].decode("utf-8", "replace")
    if " -> " in path: path = path.split(" -> ", 1)[1]
    paths.append(path)
for path in paths:
    for prefix in protected:
        prefix = prefix.rstrip("/")
        if path == prefix or path.startswith(prefix + "/"):
            print("protected\t" + path)
            raise SystemExit(1)
out = subprocess.check_output(["git", "-C", root, "diff", "--numstat", "HEAD"], text=True)
changed = 0
for row in out.splitlines():
    added, removed, _ = row.split("\t", 2)
    changed += (int(added) if added.isdigit() else 0) + (int(removed) if removed.isdigit() else 0)
tracked = set(subprocess.check_output(["git", "-C", root, "ls-files"], text=True).splitlines())
for path in paths:
    if path not in tracked and os.path.isfile(os.path.join(root, path)):
        with open(os.path.join(root, path), "rb") as f: changed += sum(1 for _ in f)
if changed > limit:
    print("lines\t%d\t%d" % (changed, limit))
    raise SystemExit(1)
print("ok\t%d\t%d" % (changed, limit))
PY
  )
  status=$?
  case $result in
    protected$'\t'*) jpdev_die "codex run --small: refused after the run: ${result#*$'\t'} is a shared or boundary path" ;;
    lines$'\t'*) local rest=${result#*$'\t'}; jpdev_die "codex run --small: refused after the run: ${rest%%$'\t'*} changed lines exceeds JPDEV_SMALL_MAX_LINES=${rest#*$'\t'}" ;;
  esac
  [ "$status" -eq 0 ] || jpdev_die "codex run --small: could not inspect the change: $result"
}

# codex_publish DIR BRANCH PUSH PR REPO BASE [ADD...]: stage the tracked changes (and the paths
# named with --add; never an untracked file otherwise, never msg.txt or pr.md), commit them signed
# off with the message in msg.txt plus the Codex trailer, push the branch, open the pull request
# from pr.md. Exits 0 when every step asked for was done, 1 when there was nothing to commit or a
# file was missing, and the failing command's status otherwise.
codex_publish() {
  local dir=$1 branch=$2 push=$3 pr=$4 repo=$5 base=$6
  shift 6
  local trailer="Co-Authored-By: Codex <noreply@openai.com>" tmpd msg_tracked=0 pr_tracked=0
  cd "$dir" || exit 2
  if [ ! -s msg.txt ]; then
    echo "jpdev codex run: refused: codex wrote no msg.txt (the commit message); nothing was committed" >&2
    exit 1
  fi
  if [ "$pr" -eq 1 ] && [ "$push" -eq 1 ] && [ ! -s pr.md ]; then
    echo "jpdev codex run: refused: codex wrote no pr.md (the pull request body); nothing was committed" >&2
    exit 1
  fi
  git ls-files --error-unmatch -- msg.txt > /dev/null 2>&1 && msg_tracked=1
  git ls-files --error-unmatch -- pr.md > /dev/null 2>&1 && pr_tracked=1
  git add -u || exit 1
  local path pending add_dirs=()
  for path in "$@"; do
    if [ -d "$path" ]; then
      add_dirs+=("$path")
      pending=$(git status --porcelain --untracked-files=all -- "$path") || exit 1
      if [ -z "$pending" ]; then continue; fi
    fi
    git add -- "$path" || { echo "jpdev codex run: --add $path could not be staged" >&2; exit 1; }
  done
  local cache_paths=()
  while IFS= read -r -d '' path; do
    case /$path/ in
      */.jpdev/* | */.jpdev-shared/* | */.gocache/* | */.npm-cache/* | */.xdg-cache/*) cache_paths+=("$path") ;;
    esac
  done < <(git diff --cached --name-only -z)
  if [ "${#cache_paths[@]}" -gt 0 ]; then
    git rm -r --cached --quiet --ignore-unmatch -- "${cache_paths[@]}" || exit 1
  fi
  if git diff --cached --name-only | grep -qE '(^|/)\.(jpdev|jpdev-shared|gocache|npm-cache|xdg-cache)(/|$)'; then
    jpdev_die "codex run: a sandbox cache directory remained staged"
  fi
  local tracked_handover=0 handover_paths=() nested_tracked_handover=() add_path
  local -A seen_nested_handover=()
  for add_path in "${add_dirs[@]}"; do
    while IFS= read -r -d '' path; do
      case $path in
        */msg.txt | */pr.md)
          if [ -n "${seen_nested_handover[$path]:-}" ]; then continue; fi
          seen_nested_handover[$path]=1
          if git cat-file -e "HEAD:$path" 2>/dev/null; then
            nested_tracked_handover+=("$path")
          else
            handover_paths+=("$path")
          fi
          ;;
      esac
    done < <(git diff --cached --name-only -z -- "$add_path")
  done
  if ! git diff --cached --quiet -- msg.txt; then
    if [ "$msg_tracked" -eq 1 ]; then tracked_handover=1; else handover_paths+=(msg.txt); fi
  fi
  if ! git diff --cached --quiet -- pr.md; then
    if [ "$pr_tracked" -eq 1 ]; then tracked_handover=1; else handover_paths+=(pr.md); fi
  fi
  if [ "${#handover_paths[@]}" -gt 0 ]; then
    git rm --cached --quiet --ignore-unmatch -- "${handover_paths[@]}" || exit 1
  fi
  if [ "${#nested_tracked_handover[@]}" -gt 0 ]; then
    git reset -q -- "${nested_tracked_handover[@]}" || exit 1
  fi
  if [ "$tracked_handover" -eq 1 ]; then
    git reset -q -- msg.txt pr.md
    echo "jpdev codex run: refused: msg.txt or pr.md is tracked and changed; they are read, never committed" >&2
    exit 1
  fi
  for path in "${add_dirs[@]}"; do
    if git diff --cached --quiet -- "$path"; then
      echo "jpdev codex run: --add $path: directory holds nothing to add" >&2
      exit 1
    fi
  done
  if git diff --cached --quiet; then
    echo "jpdev codex run: nothing to commit: codex made no change to a tracked file" >&2
    exit 1
  fi
  tmpd=$(mktemp -d)
  git interpret-trailers --if-exists addIfDifferent --trailer "$trailer" msg.txt > "$tmpd/message" || { rm -rf -- "${tmpd:?}"; exit 1; }
  git commit -q -s -F "$tmpd/message" || { local st=$?; rm -rf -- "${tmpd:?}"; echo "jpdev codex run: the commit failed" >&2; exit "$st"; }
  local subject sha
  subject=$(head -n 1 "$tmpd/message")
  rm -rf -- "${tmpd:?}"
  sha=$(git rev-parse --short HEAD)
  echo "== jpdev codex run: committed $sha on $branch =="
  git diff-tree --no-commit-id --name-status -r HEAD
  local stray
  stray=$(git ls-files --others --exclude-standard | grep -vxE 'msg\.txt|pr\.md')
  if [ -n "$stray" ]; then
    echo "untracked files left out of the commit (pass --add PATH to include one):"
    printf '  %s\n' "$stray"
  fi
  [ "$push" -eq 1 ] || exit 0
  (cmd_push "$branch") || { local st=$?; echo "jpdev codex run: the push failed; the commit $sha is local" >&2; exit "$st"; }
  echo "== jpdev codex run: pushed $branch =="
  [ "$pr" -eq 1 ] || exit 0
  gh pr create --repo "$repo" --base "$base" --head "$branch" --title "$subject" --body-file pr.md || { local st=$?; echo "jpdev codex run: opening the pull request failed; the branch is pushed" >&2; exit "$st"; }
  exit 0
}

# codex_brief_template prints the brief skeleton a Codex build or review starts from.
codex_brief_template() {
  case ${1:-} in
    "")
      cat "$kit/templates/codex-brief.md"
      local root manifest notes
      root=$(git rev-parse --show-toplevel 2>/dev/null || true)
      manifest=${root:+$root/dev.json}
      if [ -n "$manifest" ] && [ -f "$manifest" ]; then
        notes=$(python3 -I - "$manifest" <<'PY'
import json, sys
try:
    notes = json.load(open(sys.argv[1], encoding='utf-8')).get('notes', [])
except (OSError, ValueError, AttributeError):
    notes = []
if not isinstance(notes, list): notes = []
for note in notes:
    if isinstance(note, str): print('- ' + note)
PY
)
        if [ -n "$notes" ]; then
          printf "\n## This repository's notes\n\n%s\n" "$notes"
        fi
      fi
      ;;
    --review) [ $# -eq 1 ] || jpdev_die "codex brief-template: --review takes no value"; cat "$kit/templates/codex-review-brief.md" ;;
    *) jpdev_die "codex brief-template: unknown argument $1" ;;
  esac
}

# cmd_carry merges the current base into a pull-request branch. Conflicts are handed to the same
# codex_run path as a normal --no-pr build, using a generated brief.
cmd_carry() {
  local pr="" model=$JPDEV_CODEX_MODEL_DEFAULT effort="" dir=. dir_given=0 repo="" base=main
  local sandbox=$JPDEV_CODEX_SANDBOX worktree=""
  while [ $# -gt 0 ]; do
    case $1 in
      --pr) need_value "$@"; pr=$2; shift 2 ;;
      --model) need_value "$@"; model=$2; shift 2 ;;
      --effort) need_value "$@"; effort=$2; shift 2 ;;
      --dir) need_value "$@"; dir=$2; dir_given=1; shift 2 ;;
      --repo) need_value "$@"; repo=$2; shift 2 ;;
      --base) need_value "$@"; base=$2; shift 2 ;;
      --worktree) need_value "$@"; worktree=$2; shift 2 ;;
      --sandbox) need_value "$@"; sandbox=$2; shift 2 ;;
      *) jpdev_die "carry: unknown argument $1" ;;
    esac
  done
  [ -n "$pr" ] || jpdev_die "carry: --pr N is needed"
  [ -n "$model" ] || jpdev_die "carry: --model is needed"
  case $effort in low | medium | high) ;; *) jpdev_die "carry: --effort is low, medium or high" ;; esac
  local view branch pr_base
  view=$(gh pr view "$pr" ${repo:+--repo "$repo"} --json headRefName,baseRefName --jq '.headRefName + "\t" + .baseRefName') || jpdev_die "carry: could not read pull request #$pr"
  IFS=$'\t' read -r branch pr_base <<< "$view"
  [ -n "$branch" ] || jpdev_die "carry: pull request #$pr has no branch"
  [ -z "$pr_base" ] || base=$pr_base
  if [ -n "$worktree" ]; then
    if [ "$dir_given" -eq 0 ]; then dir=$(dirname "$worktree")/"$(basename "$worktree")-${branch//\//-}"; fi
    if [ ! -d "$dir" ]; then
      if ! git -C "$worktree" show-ref --verify -q "refs/heads/$branch"; then
        jpdev_git_net -C "$worktree" fetch -q origin "$branch:$branch" || jpdev_die "carry: could not fetch $branch"
      fi
      worktree_add "$worktree" "$branch" "$dir" "origin/$base" > /dev/null
    fi
  elif [ ! -d "$dir" ]; then
    [ -n "$repo" ] || jpdev_die "carry: $dir is not a clone; give --repo OWNER/NAME or --worktree BASE"
    gh repo clone "$repo" "$dir" -- -q || jpdev_die "carry: the clone failed"
  fi
  dir=$(cd "$dir" && git rev-parse --show-toplevel) || jpdev_die "carry: --dir is not a git clone"
  jpdev_git_net -C "$dir" fetch -q origin "$base" || jpdev_die "carry: could not fetch origin/$base"
  if [ "$(git -C "$dir" symbolic-ref --short -q HEAD)" != "$branch" ]; then
    if git -C "$dir" show-ref --verify -q "refs/heads/$branch"; then
      git -C "$dir" switch -q "$branch" || jpdev_die "carry: could not switch to $branch"
    else
      jpdev_git_net -C "$dir" fetch -q origin "$branch:$branch" || jpdev_die "carry: could not fetch $branch"
      git -C "$dir" switch -q "$branch" || jpdev_die "carry: could not switch to $branch"
    fi
  fi
  [ -z "$(git -C "$dir" status --porcelain)" ] || jpdev_die "carry: $dir has uncommitted work"
  local merge_status=0
  git -C "$dir" merge --no-ff --no-commit "origin/$base" || merge_status=$?
  if [ "$merge_status" -eq 0 ]; then
    if git -C "$dir" diff --cached --quiet; then
      jpdev_log "carry: $branch already contains origin/$base"
    else
      git -C "$dir" commit -q -s -m "Merge origin/$base into $branch" || jpdev_die "carry: the merge commit failed"
    fi
    (cd "$dir" && cmd_push "$branch") || jpdev_die "carry: the push failed"
    echo "== jpdev carry: pushed $branch =="
    return
  fi
  local conflicts
  conflicts=$(git -C "$dir" diff --name-only --diff-filter=U)
  [ -n "$conflicts" ] || jpdev_die "carry: git merge failed without conflicts"
  mkdir -p "$dir/.jpdev/output"
  local brief=$dir/.jpdev/output/carry-brief.md base_commit
  base_commit=$(git -C "$dir" rev-parse "origin/$base")
  python3 -I - "$kit/templates/carry-brief.md" "$brief" "$pr" "$branch" "$base_commit" "$conflicts" <<'PY'
import sys
source, target, number, branch, base, conflicts = sys.argv[1:]
text = open(source, encoding="utf-8").read()
for old, new in (("{{PR}}", number), ("{{BRANCH}}", branch), ("{{BASE_COMMIT}}", base), ("{{CONFLICTS}}", conflicts)):
    text = text.replace(old, new)
open(target, "w", encoding="utf-8").write(text)
PY
  jpdev_log "carry: conflicts remain; generated $brief"
  codex_run --brief "$brief" --model "$model" --effort "$effort" --sandbox "$sandbox" --dir "$dir" --base "$base" --no-pr
}

cmd_env() {
  local v cfg manifest pyv venv chosen
  cfg=$(jpdev_config_file)
  printf 'jpdev %s\nkit      %s\nconfig   %s (%s)\n\n' "$JPDEV_VERSION" "$kit" "$cfg" "$([ -f "$cfg" ] && echo present || echo absent)"
  for v in "${JPDEV_SETTINGS[@]}"; do printf '%-22s %-48s %s\n' "$v" "${!v}" "${JPDEV_SOURCE[$v]}"; done
  printf '\n'
  local tool
  for tool in git gh python3 rsync flock go shellcheck; do
    printf '%-10s %s\n' "$tool" "$(command -v "$tool" || echo 'not on PATH')"
  done
  printf '%-10s %s\n' python3.12 "$(jpdev_python_bin 3.12 || echo none)"
  printf '%-10s %s\n' node22 "$(jpdev_node_bin 22 || echo "none under $JPDEV_NVM_DIR")"
  manifest=${JPDEV_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null)}/dev.json
  if [ -f "$manifest" ]; then
    pyv=$(jpdev_manifest_get "$manifest" toolchains python version)
    venv=$(jpdev_manifest_get "$manifest" toolchains python venv)
    if [ -n "$venv" ] && [ -x "${manifest%/dev.json}/$venv/bin/python" ]; then
      chosen=${manifest%/dev.json}/$venv/bin/python
    elif [ -n "$pyv" ]; then
      chosen=$(jpdev_python_bin "$pyv" || echo "not installed")
    else
      chosen=$(command -v python3 || echo "not on PATH")
    fi
    printf '%-10s %s\n' manifest-python "$chosen${pyv:+ (declared $pyv)}${venv:+ (venv $venv)}"
  fi
  [ -f "$JPDEV_NAME_PATTERNS" ] || echo "name-pattern file absent: jpdev record post refuses to post without --no-name-check"
}

case ${1:-} in
  setup) shift; cmd_setup "$@" ;;
  check) shift; cmd_check "$@" ;;
  mutants) shift; cmd_mutants "$@" ;;
  record) shift; cmd_record "$@" ;;
  push) shift; cmd_push "$@" ;;
  clean) shift; exec python3 -I "$kit/lib/clean.py" "$@" ;;
  worktree) shift; cmd_worktree "$@" ;;
  carry) shift; cmd_carry "$@" ;;
  codex) shift; cmd_codex "$@" ;;
  env) shift; cmd_env "$@" ;;
  --version) echo "jpdev $JPDEV_VERSION" ;;
  version) kit_version ;;
  -h | --help | help | "") usage; [ -n "${1:-}" ] || exit 2 ;;
  *) echo "jpdev: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
