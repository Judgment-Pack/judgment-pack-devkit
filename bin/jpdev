#!/usr/bin/env bash
# jpdev: the development kit of the Judgment Pack repositories. See README.md.
set -u
here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
kit=$(dirname "$here")
# shellcheck source=lib/common.sh
. "$kit/lib/common.sh"
jpdev_load_config

usage() {
  cat <<'USAGE'
usage: jpdev COMMAND [ARGS]
  setup DIR [--repo OWNER/NAME] [--branch NAME] [--base origin/main] [--manifest FILE]
                     clone (or reuse) a repository, make the branch, select the toolchains
                     the manifest names, and run its setup steps under the caps
  check [--only A,B] [--skip A,B] [--all] [--manifest FILE]
                     run the manifest's checks in order under the caps; exit status = failures
  mutants --row TEXT [--row TEXT]...
                     run the manifest's mutants command on a scratch copy of the clone
  record post (--pr N | --issue N) --file FILE [--repo OWNER/NAME] [--dry-run] [--no-name-check]
                     reduce local paths, refuse a path, a name pattern, a missing or invalid
                     name-pattern file, then post the file
  push [BRANCH]      push BRANCH (default: the current branch) to origin with the gh credential
                     helper and no stored credential; refuses --force and -f
  codex run --brief FILE --model M --effort low|medium|high [--dir CLONE] [--repo OWNER/NAME]
            [--base main] [--add PATH]... [--no-commit] [--no-push] [--no-pr]
            [--sandbox workspace-write|danger-full-access] [--log FILE]
                     check the brief, run `codex exec` on it in CLONE (a work branch) with the
                     model, effort and sandbox explicit, stdin closed and the transcript in the
                     log; print the final message and the exit code; then commit the tracked
                     changes (msg.txt, signed off), push, and open the pull request (pr.md)
  codex brief-template
                     print the brief skeleton: what Codex writes (msg.txt, pr.md) and does not do
  codex check-brief FILE
                     refuse a brief that holds a word of the filter list, and suggest the
                     neutral phrasing
  env                print the effective settings and where each came from
  --version          print the version
USAGE
}

need_value() { [ $# -ge 2 ] || jpdev_die "$1 needs a value"; }

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || jpdev_die "not inside a git clone"
}

cmd_check() {
  local root manifest="" passthru=()
  while [ $# -gt 0 ]; do
    case $1 in
      --manifest) need_value "$@"; manifest=$2; shift 2 ;;
      --only | --skip) need_value "$@"; passthru+=("$1" "$2"); shift 2 ;;
      --all) passthru+=(--all); shift ;;
      -h | --help) usage; exit 0 ;;
      *) jpdev_die "check: unknown argument $1" ;;
    esac
  done
  root=$(repo_root)
  : "${manifest:=$root/dev.json}"
  jpdev_prepare_run "$root" "$manifest"
  local script=$root/scripts/dev/check.sh
  [ -x "$script" ] || script=$kit/templates/check.sh
  local logdir
  logdir=$JPDEV_SCRATCH/logs/$(basename "$root")-$(date +%Y%m%dT%H%M%S)
  export JPDEV_LOGDIR=$logdir
  "$script" --manifest "$manifest" "${passthru[@]}"
  local status=$?
  jpdev_log "full output of each check: $logdir"
  exit "$status"
}

cmd_setup() {
  local dir="" repo="" branch="" base=origin/main manifest=""
  while [ $# -gt 0 ]; do
    case $1 in
      --repo) need_value "$@"; repo=$2; shift 2 ;;
      --branch) need_value "$@"; branch=$2; shift 2 ;;
      --base) need_value "$@"; base=$2; shift 2 ;;
      --manifest) need_value "$@"; manifest=$2; shift 2 ;;
      -h | --help) usage; exit 0 ;;
      -*) jpdev_die "setup: unknown argument $1" ;;
      *) [ -z "$dir" ] || jpdev_die "setup: one directory only"; dir=$1; shift ;;
    esac
  done
  [ -n "$dir" ] || jpdev_die "setup: a directory is needed"
  if [ ! -e "$dir/.git" ]; then
    [ -n "$repo" ] || jpdev_die "setup: $dir is not a clone; give --repo OWNER/NAME to clone it"
    gh repo clone "$repo" "$dir" -- -q || jpdev_die "setup: the clone failed"
  fi
  local root
  root=$(cd "$dir" && git rev-parse --show-toplevel) || jpdev_die "setup: $dir is not a git clone"
  cd "$root" || exit 2
  [ -n "$repo" ] || repo=$(git remote get-url origin 2>/dev/null | sed -E 's#^(git@github.com:|https://github.com/)##; s#\.git$##')
  jpdev_git_net fetch -q origin || jpdev_die "setup: git fetch failed"
  if [ -n "$branch" ]; then
    if git show-ref --verify -q "refs/heads/$branch"; then
      git switch -q "$branch" || jpdev_die "setup: cannot switch to $branch"
    else
      git switch -q -c "$branch" "$base" || jpdev_die "setup: cannot create $branch from $base"
    fi
  fi
  : "${manifest:=$root/dev.json}"
  jpdev_prepare_run "$root" "$manifest"
  local go_v py_v venv pyv py gov
  if [ -n "$(jpdev_manifest_get "$manifest" toolchains go)" ]; then
    go_v=$("${JPDEV_GO_BIN:+$JPDEV_GO_BIN/}go" version 2>/dev/null) || jpdev_die "setup: the manifest names go, which is not on PATH"
    gov=$(jpdev_manifest_get "$manifest" toolchains go version)
    if [ -n "$gov" ] && [ -n "${JPDEV_GO_BIN:-}" ]; then
      go_v="$go_v (selected for the manifest's go $gov)"
    elif [ -n "$gov" ]; then
      go_v="$go_v (the manifest names go $gov and no matching Go is installed: this one is used)"
    fi
  fi
  venv=$(jpdev_manifest_get "$manifest" toolchains python venv)
  pyv=$(jpdev_manifest_get "$manifest" toolchains python version)
  py=python3
  if [ -n "$pyv" ]; then
    py=$(jpdev_python_bin "$pyv") || jpdev_die "setup: the manifest names python $pyv, which is not installed (python$pyv on PATH, or a pyenv version)"
  fi
  if [ -n "$venv" ]; then
    if [ ! -d "$root/$venv" ]; then
      JPDEV_STEP_TIMEOUT=300 "$JPDEV_WRAP" python -- "$py" -m venv "$root/$venv" || jpdev_die "setup: the virtual environment failed"
    fi
    py_v=$("$root/$venv/bin/python" --version 2>&1)
    grep -qxF "/$venv/" "$root/.git/info/exclude" 2>/dev/null || printf '/%s/\n' "$venv" >> "$root/.git/info/exclude"
  else
    py_v=$("$py" --version 2>&1)
  fi
  local script=$root/scripts/dev/check.sh
  [ -x "$script" ] || script=$kit/templates/check.sh
  JPDEV_LOGDIR=$JPDEV_SCRATCH/logs/$(basename "$root")-setup-$(date +%Y%m%dT%H%M%S)
  export JPDEV_LOGDIR
  local block status
  block=$("$script" --manifest "$manifest" --setup --all)
  status=$?
  echo "== jpdev setup =="
  printf '%-8s %s\n' repo "${repo:-unknown}" dir "$dir" \
    branch "$(git rev-parse --abbrev-ref HEAD) at $(git rev-parse --short HEAD) (base $base)" \
    node "${JPDEV_NODE_BIN:+$("$JPDEV_NODE_BIN/node" --version)}" \
    go "${go_v:-not used}" python "$py_v${venv:+ (virtual environment $venv)}"
  printf '%s\n' "$block"
  exit "$status"
}

cmd_mutants() {
  local rows=() manifest=""
  while [ $# -gt 0 ]; do
    case $1 in
      --row) need_value "$@"; rows+=("$2"); shift 2 ;;
      --manifest) need_value "$@"; manifest=$2; shift 2 ;;
      -h | --help) usage; exit 0 ;;
      *) jpdev_die "mutants: unknown argument $1" ;;
    esac
  done
  [ ${#rows[@]} -gt 0 ] || jpdev_die "mutants: at least one --row TEXT is needed"
  local root run cwd tc tmo
  root=$(repo_root)
  : "${manifest:=$root/dev.json}"
  jpdev_prepare_run "$root" "$manifest"
  run=$(jpdev_manifest_get "$manifest" mutants run)
  [ -n "$run" ] || jpdev_die "mutants: the manifest has no mutants command"
  cwd=$(jpdev_manifest_get "$manifest" mutants cwd); : "${cwd:=.}"
  tc=$(jpdev_manifest_get "$manifest" mutants toolchain)
  if [ -z "$tc" ]; then if [ -n "${JPDEV_NODE_BIN:-}" ]; then tc=node; else tc=shell; fi; fi
  tmo=$(jpdev_manifest_get "$manifest" mutants timeout); : "${tmo:=3000}"
  copy=$JPDEV_SCRATCH/mutants/$(jpdev_clone_key "$root")-$$
  mkdir -p "$copy"
  trap 'rm -rf -- "${copy:?}"' EXIT
  rsync -a --exclude .git --exclude node_modules --exclude .venv "$root/" "$copy/" || jpdev_die "mutants: the scratch copy failed"
  local found rel
  while IFS= read -r found; do
    rel=${found#"$root"/}
    mkdir -p "$copy/$(dirname "$rel")"
    ln -s "$found" "$copy/$rel"
  done < <(find "$root" -name node_modules -type d -not -path '*/node_modules/*' -not -path "$root/.git/*" -prune -print)
  local args="" row
  for row in "${rows[@]}"; do args+=$(printf ' --row %q' "$row"); done
  local out=$copy/.jpdev-mutants.out
  (cd "$copy/$cwd" && JPDEV_ROOT=$copy JPDEV_STEP_TIMEOUT=$tmo "$JPDEV_WRAP" "$tc" -- bash -c "${run//\{rows\}/$args}") > "$out" 2>&1
  local status=$?
  echo "== jpdev mutants (exit $status of the mutants command) =="
  python3 -I "$kit/lib/mutants_report.py" "${rows[@]}" < "$out"
  local missed=$?
  if [ "$missed" -eq 0 ] && [ "$status" -ne 0 ]; then
    echo "the command failed with no row reported; its last lines:"; tail -n 20 "$out"
    missed=1
  fi
  exit "$missed"
}

# reduce_paths FILE prints FILE with the scratch and home directories named as <scratch> and <home>.
reduce_paths() {
  python3 -I -c '
import os, sys
text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
pairs = [(sys.argv[2], "<scratch>"), (os.path.realpath(sys.argv[2]), "<scratch>"), (sys.argv[3], "<home>"), (os.path.realpath(sys.argv[3]), "<home>")]
for old, new in sorted(set(pairs), key=lambda p: -len(p[0])):
    if old.strip("/"):
        text = text.replace(old, new)
sys.stdout.write(text)' "$1" "$JPDEV_SCRATCH" "$HOME"
}

cmd_record() {
  [ "${1:-}" = post ] || jpdev_die "record: the only subcommand is post"
  shift
  local pr="" issue="" file="" repo="" dry=0 name_check=1
  while [ $# -gt 0 ]; do
    case $1 in
      --pr) need_value "$@"; pr=$2; shift 2 ;;
      --issue) need_value "$@"; issue=$2; shift 2 ;;
      --file) need_value "$@"; file=$2; shift 2 ;;
      --repo) need_value "$@"; repo=$2; shift 2 ;;
      --dry-run) dry=1; shift ;;
      --no-name-check) name_check=0; shift ;;
      *) jpdev_die "record: unknown argument $1" ;;
    esac
  done
  [ -f "$file" ] || jpdev_die "record: --file must name a file"
  { [ -n "$pr" ] && [ -z "$issue" ]; } || { [ -z "$pr" ] && [ -n "$issue" ]; } || jpdev_die "record: give --pr N or --issue N"
  local status=0
  tmpd=$(mktemp -d)
  trap 'rm -rf -- "${tmpd:?}"' EXIT
  local reduced=$tmpd/reduced
  reduce_paths "$file" > "$reduced"
  if grep -nE '(^|[^A-Za-z0-9_<.-])(/(home|tmp|Users|root|mnt)/[A-Za-z0-9_.-]+|~/[A-Za-z0-9_.-]+)' "$reduced" > "$tmpd/paths"; then
    echo "jpdev record: refused: a local path remains after the scratch and home paths were reduced:" >&2
    cut -d: -f1 "$tmpd/paths" | sed 's/^/  line /' >&2
    status=1
  fi
  if [ "$name_check" -eq 0 ]; then
    jpdev_log "--no-name-check: the name check did not run"
  elif [ ! -f "$JPDEV_NAME_PATTERNS" ]; then
    echo "jpdev record: refused: no name-pattern file at $JPDEV_NAME_PATTERNS (create it, or pass --no-name-check to post without the name check)" >&2
    status=1
  else
    local patterns=$tmpd/patterns grep_status
    grep -vE '^[[:space:]]*(#|$)' "$JPDEV_NAME_PATTERNS" > "$patterns"
    if [ ! -s "$patterns" ]; then
      jpdev_log "the name-pattern file $JPDEV_NAME_PATTERNS holds no pattern: the name check matched nothing"
    else
      grep -Eif "$patterns" /dev/null > /dev/null 2>&1
      grep_status=$?
      if [ "$grep_status" -eq 2 ]; then
        echo "jpdev record: refused: the name-pattern file holds a pattern grep -E cannot compile" >&2
        status=1
      else
        grep -nEif "$patterns" "$reduced" > "$tmpd/names"
        grep_status=$?
        if [ "$grep_status" -eq 0 ]; then
          echo "jpdev record: refused: these lines match a pattern of the name list:" >&2
          cut -d: -f1 "$tmpd/names" | sed 's/^/  line /' >&2
          status=1
        elif [ "$grep_status" -ne 1 ]; then
          echo "jpdev record: refused: the name check failed (grep exit $grep_status)" >&2
          status=1
        fi
      fi
    fi
  fi
  [ "$status" -eq 0 ] || exit 1
  local kind=pr number=$pr
  if [ -n "$issue" ]; then kind=issue; number=$issue; fi
  if [ "$dry" -eq 1 ]; then
    echo "jpdev record: dry run: would post $(wc -l < "$reduced") lines on $kind #$number${repo:+ of $repo}"
    exit 0
  fi
  gh "$kind" comment "$number" ${repo:+--repo "$repo"} --body-file "$reduced"
}

# cmd_push [BRANCH]: the push form with the gh credential helper, never a stored credential.
cmd_push() {
  local branch="" arg
  for arg in "$@"; do
    case $arg in
      --force* | -f* | +*) jpdev_die "push: refused: a force push is never made (jpdev push takes a branch name only)" ;;
      -*) jpdev_die "push: unknown argument $arg (jpdev push takes a branch name only)" ;;
      *) [ -z "$branch" ] || jpdev_die "push: one branch only"; branch=$arg ;;
    esac
  done
  repo_root > /dev/null
  if [ -z "$branch" ]; then
    branch=$(git symbolic-ref --short -q HEAD) || jpdev_die "push: HEAD is not on a branch; name the branch"
  fi
  git check-ref-format --branch "$branch" > /dev/null 2>&1 || jpdev_die "push: '$branch' is not a branch name"
  jpdev_git_net push -u origin "$branch"
}

# cmd_codex run|check-brief ...
cmd_codex() {
  local sub=${1:-}
  [ $# -eq 0 ] || shift
  case $sub in
    run) codex_run "$@" ;;
    check-brief) codex_check_brief "$@" ;;
    brief-template) codex_brief_template ;;
    -h | --help | help) usage; exit 0 ;;
    *) jpdev_die "codex: the subcommands are run, check-brief and brief-template" ;;
  esac
}

# codex_check_brief FILE: exit 1 and the neutral phrasing for each word of the filter list in FILE.
codex_check_brief() {
  local file=""
  while [ $# -gt 0 ]; do
    case $1 in
      -h | --help) usage; exit 0 ;;
      -*) jpdev_die "codex check-brief: unknown argument $1" ;;
      *) [ -z "$file" ] || jpdev_die "codex check-brief: one brief only"; file=$1; shift ;;
    esac
  done
  [ -f "$file" ] || jpdev_die "codex check-brief: give the brief file"
  local out status
  out=$(python3 -I "$kit/lib/codex_words.py" "$file" "$kit/config/codex-words.txt" "$JPDEV_CODEX_WORDS")
  status=$?
  case $status in
    0) echo "jpdev codex check-brief: no word of the filter list in $file" ;;
    1)
      printf 'jpdev codex check-brief: refused: %s holds words the content filter trips on:\n' "$file" >&2
      printf '  %s\n' "${out//$'\n'/$'\n'  }" >&2
      echo "describe the documented refusal instead (the input, and the exact refusal the code must produce)" >&2
      exit 1
      ;;
    *) jpdev_die "codex check-brief: the check failed (exit $status)" ;;
  esac
}

# codex_run: the Codex CLI build from a brief, then the git part (commit, push, pull request).
# Codex runs in workspace-write and cannot write .git, so the wrapper commits, pushes and opens
# the pull request itself from the msg.txt and pr.md that Codex wrote.
codex_run() {
  local brief="" model=$JPDEV_CODEX_MODEL_DEFAULT effort="" dir=. sandbox=$JPDEV_CODEX_SANDBOX log=""
  local repo="" base=main commit=1 push=1 pr=1 adds=()
  while [ $# -gt 0 ]; do
    case $1 in
      --brief) need_value "$@"; brief=$2; shift 2 ;;
      --model) need_value "$@"; model=$2; shift 2 ;;
      --effort) need_value "$@"; effort=$2; shift 2 ;;
      --dir) need_value "$@"; dir=$2; shift 2 ;;
      --sandbox) need_value "$@"; sandbox=$2; shift 2 ;;
      --log) need_value "$@"; log=$2; shift 2 ;;
      --repo) need_value "$@"; repo=$2; shift 2 ;;
      --base) need_value "$@"; base=$2; shift 2 ;;
      --add) need_value "$@"; adds+=("$2"); shift 2 ;;
      --no-commit) commit=0; shift ;;
      --no-push) push=0; shift ;;
      --no-pr) pr=0; shift ;;
      -h | --help) usage; exit 0 ;;
      *) jpdev_die "codex run: unknown argument $1" ;;
    esac
  done
  [ -f "$brief" ] || jpdev_die "codex run: --brief must name a file"
  [ -n "$model" ] || jpdev_die "codex run: --model is needed (the model is always passed; JPDEV_CODEX_MODEL_DEFAULT can name one)"
  case $effort in
    low | medium | high) ;;
    *) jpdev_die "codex run: --effort is low, medium or high" ;;
  esac
  case $sandbox in
    workspace-write | danger-full-access) ;;
    *) jpdev_die "codex run: --sandbox is workspace-write or danger-full-access" ;;
  esac
  [ -d "$dir" ] || jpdev_die "codex run: --dir is not a directory"
  dir=$(cd "$dir" && pwd)
  [ -f "$dir/AGENTS.md" ] || jpdev_die "codex run: $dir holds no AGENTS.md, which the prompt names as the rules"
  command -v codex > /dev/null || jpdev_die "codex run: codex is not on PATH"
  local branch=""
  if [ "$commit" -eq 1 ]; then
    git -C "$dir" rev-parse --show-toplevel > /dev/null 2>&1 || jpdev_die "codex run: $dir is not a git clone (--no-commit runs codex alone)"
    branch=$(git -C "$dir" symbolic-ref --short -q HEAD) || jpdev_die "codex run: HEAD is not on a branch"
    case $branch in
      main | master) jpdev_die "codex run: the clone is on $branch; make a work branch first (the wrapper commits and pushes the current branch)" ;;
    esac
    if [ "$push" -eq 1 ] && [ "$pr" -eq 1 ] && [ -z "$repo" ]; then
      jpdev_die "codex run: --repo OWNER/NAME is needed to open the pull request (--no-pr stops after the push)"
    fi
    local path
    for path in "${adds[@]}"; do
      case $path in
        msg.txt | pr.md | ./msg.txt | ./pr.md) jpdev_die "codex run: --add $path: msg.txt and pr.md are read, never committed" ;;
        /* | .. | ../* | */../*) jpdev_die "codex run: --add takes a path inside the clone" ;;
      esac
    done
  fi
  brief=$(cd "$(dirname "$brief")" && pwd)/$(basename "$brief")
  codex_check_brief "$brief"
  if [ -z "$log" ]; then
    mkdir -p "$JPDEV_SCRATCH/logs"
    log=$JPDEV_SCRATCH/logs/codex-$(basename "$dir")-$(date +%Y%m%dT%H%M%S).log
  fi
  mkdir -p "$(dirname "$log")"
  log=$(cd "$(dirname "$log")" && pwd)/$(basename "$log")
  local final prompt
  final=$(mktemp)
  # a msg.txt or pr.md left by an earlier run is not this run's
  rm -f -- "$dir/msg.txt" "$dir/pr.md"
  prompt="The rules are this repository's AGENTS.md; follow them.
$(cat "$brief")"
  local args=(exec -m "$model" -c "model_reasoning_effort=$effort" --sandbox "$sandbox")
  if [ "$sandbox" = workspace-write ]; then args+=(-c sandbox_workspace_write.network_access=true); fi
  args+=(-C "$dir" -o "$final" "$prompt")
  jpdev_log "codex run: model $model, effort $effort, sandbox $sandbox, in $dir; transcript $log"
  (cd "$dir" && codex "${args[@]}" < /dev/null > "$log" 2>&1)
  local status=$?
  echo "== codex final message =="
  if [ -s "$final" ]; then cat "$final"; else echo "(none written)"; fi
  rm -f -- "$final"
  echo "== codex exit $status (transcript: $log) =="
  if [ "$status" -ne 0 ] || [ "$commit" -eq 0 ]; then exit "$status"; fi
  codex_publish "$dir" "$branch" "$push" "$pr" "$repo" "$base" "${adds[@]}"
}

# codex_publish DIR BRANCH PUSH PR REPO BASE [ADD...]: stage the tracked changes (and the paths
# named with --add; never an untracked file otherwise, never msg.txt or pr.md), commit them signed
# off with the message in msg.txt plus the Codex trailer, push the branch, open the pull request
# from pr.md. Exits 0 when every step asked for was done, 1 when there was nothing to commit or a
# file was missing, and the failing command's status otherwise.
codex_publish() {
  local dir=$1 branch=$2 push=$3 pr=$4 repo=$5 base=$6
  shift 6
  local trailer="Co-Authored-By: Codex <noreply@openai.com>" tmpd
  cd "$dir" || exit 2
  if [ ! -s msg.txt ]; then
    echo "jpdev codex run: refused: codex wrote no msg.txt (the commit message); nothing was committed" >&2
    exit 1
  fi
  if [ "$pr" -eq 1 ] && [ "$push" -eq 1 ] && [ ! -s pr.md ]; then
    echo "jpdev codex run: refused: codex wrote no pr.md (the pull request body); nothing was committed" >&2
    exit 1
  fi
  git add -u || exit 1
  local path
  for path in "$@"; do
    git add -- "$path" || { echo "jpdev codex run: --add $path could not be staged" >&2; exit 1; }
  done
  if git diff --cached --name-only | grep -qxE 'msg\.txt|pr\.md'; then
    git reset -q -- msg.txt pr.md
    echo "jpdev codex run: refused: msg.txt or pr.md is tracked and changed; they are read, never committed" >&2
    exit 1
  fi
  if git diff --cached --quiet; then
    echo "jpdev codex run: nothing to commit: codex made no change to a tracked file" >&2
    exit 1
  fi
  tmpd=$(mktemp -d)
  git interpret-trailers --if-exists addIfDifferent --trailer "$trailer" msg.txt > "$tmpd/message" || { rm -rf -- "${tmpd:?}"; exit 1; }
  git commit -q -s -F "$tmpd/message" || { local st=$?; rm -rf -- "${tmpd:?}"; echo "jpdev codex run: the commit failed" >&2; exit "$st"; }
  local subject sha
  subject=$(head -n 1 "$tmpd/message")
  rm -rf -- "${tmpd:?}"
  sha=$(git rev-parse --short HEAD)
  echo "== jpdev codex run: committed $sha on $branch =="
  git diff-tree --no-commit-id --name-status -r HEAD
  local stray
  stray=$(git ls-files --others --exclude-standard | grep -vxE 'msg\.txt|pr\.md')
  if [ -n "$stray" ]; then
    echo "untracked files left out of the commit (pass --add PATH to include one):"
    printf '  %s\n' "$stray"
  fi
  [ "$push" -eq 1 ] || exit 0
  cmd_push "$branch" || { local st=$?; echo "jpdev codex run: the push failed; the commit $sha is local" >&2; exit "$st"; }
  echo "== jpdev codex run: pushed $branch =="
  [ "$pr" -eq 1 ] || exit 0
  gh pr create --repo "$repo" --base "$base" --head "$branch" --title "$subject" --body-file pr.md || { local st=$?; echo "jpdev codex run: opening the pull request failed; the branch is pushed" >&2; exit "$st"; }
  exit 0
}

# codex_brief_template prints the brief skeleton a Codex build starts from.
codex_brief_template() { cat "$kit/templates/codex-brief.md"; }

cmd_env() {
  local v cfg
  cfg=$(jpdev_config_file)
  printf 'jpdev %s\nkit      %s\nconfig   %s (%s)\n\n' "$JPDEV_VERSION" "$kit" "$cfg" "$([ -f "$cfg" ] && echo present || echo absent)"
  for v in "${JPDEV_SETTINGS[@]}"; do printf '%-22s %-48s %s\n' "$v" "${!v}" "${JPDEV_SOURCE[$v]}"; done
  printf '\n'
  local tool
  for tool in git gh python3 rsync flock go shellcheck; do
    printf '%-10s %s\n' "$tool" "$(command -v "$tool" || echo 'not on PATH')"
  done
  printf '%-10s %s\n' python3.12 "$(jpdev_python_bin 3.12 || echo none)"
  printf '%-10s %s\n' node22 "$(jpdev_node_bin 22 || echo "none under $JPDEV_NVM_DIR")"
  [ -f "$JPDEV_NAME_PATTERNS" ] || echo "name-pattern file absent: jpdev record post refuses to post without --no-name-check"
}

case ${1:-} in
  setup) shift; cmd_setup "$@" ;;
  check) shift; cmd_check "$@" ;;
  mutants) shift; cmd_mutants "$@" ;;
  record) shift; cmd_record "$@" ;;
  push) shift; cmd_push "$@" ;;
  codex) shift; cmd_codex "$@" ;;
  env) shift; cmd_env "$@" ;;
  --version | version) echo "jpdev $JPDEV_VERSION" ;;
  -h | --help | help | "") usage; [ -n "${1:-}" ] || exit 2 ;;
  *) echo "jpdev: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
